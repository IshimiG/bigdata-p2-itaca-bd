# Copia este fichero a .env (que NO se versiona) y cambia las contraseñas.
# Réplica PostgreSQL de ITACA (usuario de solo lectura que usa la ingesta)
DB_HOST=localhost
# 5432 es el puerto por defecto; cámbialo si lo tienes ocupado (p. ej. 5433)
DB_PORT=5432
DB_NAME=itaca_academico
DB_USER=lectura_bigdata
DB_PASSWORD=cambia_esta_clave_lectura

# Usuario propietario: solo lo usan docker compose y sql/cargar_datos_ejemplo.py
DB_ADMIN_USER=itaca_admin
DB_ADMIN_PASSWORD=cambia_esta_clave_admin

# Nivel del logger: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
